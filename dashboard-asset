<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Pengurusan Aset M&E - Ranhill SAJ</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>
    <style>
        :root { 
            --ranhill-dark: #0b3d91; 
            --ranhill-blue: #0077b6; 
            --ranhill-cyan: #00b4d8; 
            --ios-green: #34C759; 
            --ios-orange: #FF9500; 
            --ios-red: #FF3B30;
            --bg-gradient: linear-gradient(60deg, #0b3d91 0%, #0077b6 40%, #00b4d8 100%);
            --card-bg: #ffffff; 
        }

        body { 
            font-family: -apple-system, system-ui, sans-serif;   
            background: var(--bg-gradient); 
            margin: 0; 
            min-height: 100vh; 
            display: flex; 
            flex-direction: column; 
            color: #1c1c1e;
        }

        .glass-header { 
            width: 100%; height: 70px; 
            background: rgba(11, 61, 145, 0.9);
            backdrop-filter: blur(10px);
            display: flex; align-items: center; justify-content: space-between;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15); z-index: 1000; 
            padding: 0 25px;
            box-sizing: border-box;
            color: white;
        }

        .header-title {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .main-container {
            flex: 1;
            padding: 20px;
            max-width: 1400px;
            width: 100%;
            margin: 0 auto;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 15px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            padding: 18px;
            border-radius: 16px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-left: 5px solid var(--ranhill-blue);
        }

        .stat-info h3 { margin: 0; font-size: 12px; color: #666; font-weight: 700; }
        .stat-info .number { font-size: 24px; font-weight: 900; color: var(--ranhill-dark); margin-top: 5px; }
        .stat-icon { font-size: 28px; color: var(--ranhill-blue); background: rgba(0,119,182,0.1); padding: 12px; border-radius: 12px; }

        .content-card {
            background: white;
            border-radius: 20px;
            padding: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .search-box {
            padding: 10px 15px;
            border-radius: 12px;
            border: 1px solid #d1d1d6;
            width: 280px;
            font-size: 13px;
            outline: none;
        }

        .btn {
            background: var(--ranhill-blue);
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 13px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: opacity 0.2s;
        }
        .btn:hover { opacity: 0.9; }
        .btn-success { background: var(--ios-green); }
        .btn-warning { background: var(--ios-orange); }
        .btn-danger { background: var(--ios-red); }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            text-align: left;
        }

        th, td {
            padding: 12px 15px;
            border-bottom: 1px solid #f2f2f7;
        }

        th {
            background: #f9f9fb;
            font-weight: 800;
            color: #333;
        }

        .badge {
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            display: inline-block;
        }
        .badge-active { background: #e8f8ec; color: var(--ios-green); }
        .badge-maint { background: #fff8e6; color: var(--ios-orange); }
        .badge-broken { background: #fde8e8; color: var(--ios-red); }
        .badge-replaced { background: #e0f2fe; color: #0284c7; }
        .badge-disposed { background: #f3f4f6; color: #4b5563; }

        /* Modal Form */
        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(5px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .modal-content {
            background: white;
            width: 100%;
            max-width: 600px;
            border-radius: 20px;
            padding: 25px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 5px;
            color: #444;
        }
        .form-control {
            width: 100%;
            padding: 10px;
            border-radius: 10px;
            border: 1px solid #d1d1d6;
            box-sizing: border-box;
            font-size: 13px;
        }
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }
    </style>
</head>
<body>

    <div class="glass-header">
        <div class="header-title">
            <i class="fa fa-water"></i> Ranhill SAJ - Sistem Pengurusan Aset M&E
        </div>
        <div>
            <button class="btn btn-success" onclick="openModal('assetModal')"><i class="fa fa-plus"></i> Daftar Aset Baru</button>
            <button class="btn btn-warning" onclick="openModal('replaceModal')"><i class="fa fa-exchange-alt"></i> Penukaran Aset</button>
            <button class="btn btn-danger" onclick="openModal('disposeModal')"><i class="fa fa-trash"></i> Pelupusan Aset</button>
        </div>
    </div>

    <div class="main-container">
        <!-- Statistik Kad -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-info">
                    <h3>JUMLAH KESELURUHAN ASET</h3>
                    <div class="number" id="statTotal">0</div>
                </div>
                <i class="fa fa-cogs stat-icon"></i>
            </div>
            <div class="stat-card" style="border-left-color: var(--ios-green);">
                <div class="stat-info">
                    <h3>BEROPERASI (AKTIF)</h3>
                    <div class="number" id="statActive" style="color: var(--ios-green);">0</div>
                </div>
                <i class="fa fa-check-circle stat-icon" style="color: var(--ios-green); background: rgba(52,199,89,0.1);"></i>
            </div>
            <div class="stat-card" style="border-left-color: var(--ios-orange);">
                <div class="stat-info">
                    <h3>UNIT DITUKAR / GANTI</h3>
                    <div class="number" id="statReplaced" style="color: var(--ios-orange);">0</div>
                </div>
                <i class="fa fa-exchange-alt stat-icon" style="color: var(--ios-orange); background: rgba(255,149,0,0.1);"></i>
            </div>
            <div class="stat-card" style="border-left-color: var(--ios-red);">
                <div class="stat-info">
                    <h3>UNIT DILUPUSKAN</h3>
                    <div class="number" id="statDisposed" style="color: var(--ios-red);">0</div>
                </div>
                <i class="fa fa-trash stat-icon" style="color: var(--ios-red); background: rgba(255,59,48,0.1);"></i>
            </div>
        </div>

        <!-- Jadual Senarai Aset -->
        <div class="content-card">
            <div class="toolbar">
                <h2 style="margin:0; font-size: 16px;">Direktori Peralatan M&E (LRA & Booster Pump House)</h2>
                <input type="text" id="searchInput" class="search-box" placeholder="Cari Loji, No Siri, Kategori..." onkeyup="filterTable()">
            </div>
            <div style="overflow-x: auto;">
                <table>
                    <thead>
                        <tr>
                            <th>ID Aset</th>
                            <th>Lokasi (LRA / BPH)</th>
                            <th>Kategori M&E</th>
                            <th>Spesifikasi</th>
                            <th>No. Siri</th>
                            <th>Status Kitaran</th>
                            <th>Tindakan</th>
                        </tr>
                    </thead>
                    <tbody id="assetTableBody">
                        <!-- Data dimasukkan melalui JS -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Pendaftaran Aset Baru -->
    <div class="modal" id="assetModal">
        <div class="modal-content">
            <h3 style="margin-top:0;">Pendaftaran Aset M&E Baru</h3>
            <form id="newAssetForm" onsubmit="saveNewAsset(event)">
                <div class="grid-2">
                    <div class="form-group">
                        <label>Jenis Lokasi</label>
                        <select class="form-control" id="locType" required>
                            <option value="LRA">Loji Rawatan Air (LRA)</option>
                            <option value="BPH">Booster Pump House (BPH)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Nama Loji / Rumah Pam</label>
                        <input type="text" class="form-control" id="locName" placeholder="Cth: LRA Semangar / BPH Seri Alam" required>
                    </div>
                </div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>Kategori Peralatan</label>
                        <select class="form-control" id="catMek">
                            <option value="Pam Air Utama (Centrifugal Pump)">Pam Air Utama</option>
                            <option value="Motor Elektrik & VFD">Motor Elektrik & VFD</option>
                            <option value="Injap (Sluice/Butterfly Valve)">Injap</option>
                            <option value="Sistem Klorin & Bahan Kimia">Sistem Klorin</option>
                            <option value="Panel Kawalan & Switchgear">Panel Elektrik</option>
                            <option value="Genset Kecemasan">Genset</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Nombor Siri / Tagging</label>
                        <input type="text" class="form-control" id="serialNo" placeholder="Cth: ME-SEM-PUMP-01" required>
                    </div>
                </div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>Spesifikasi Kuasa / Kapasiti</label>
                        <input type="text" class="form-control" id="specs" placeholder="Cth: 150 kW, 500 m³/h" required>
                    </div>
                    <div class="form-group">
                        <label>Tarikh Pemasangan</label>
                        <input type="date" class="form-control" id="installDate" required>
                    </div>
                </div>
                <div style="text-align: right; margin-top: 20px;">
                    <button type="button" class="btn" style="background:#8e8e93;" onclick="closeModal('assetModal')">Batal</button>
                    <button type="submit" class="btn btn-success">Simpan Aset</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Penukaran Aset -->
    <div class="modal" id="replaceModal">
        <div class="modal-content">
            <h3 style="margin-top:0;">Modul Penukaran / Penggantian Aset M&E</h3>
            <form onsubmit="saveReplacement(event)">
                <div class="form-group">
                    <label>Pilih Aset Sedia Ada Yang Hendak Ditukar</label>
                    <select class="form-control" id="oldAssetSelect" required></select>
                </div>
                <div class="form-group">
                    <label>Sebab Penukaran</label>
                    <textarea class="form-control" id="replaceReason" rows="2" placeholder="Cth: Kerosakan motor winding / Melebihi jangka hayat operasi" required></textarea>
                </div>
                <hr style="border:0; border-top:1px solid #eee; margin:15px 0;">
                <h4 style="font-size:13px; color:var(--ranhill-blue); margin-bottom:10px;">Maklumat Unit Gantian Baharu</h4>
                <div class="grid-2">
                    <div class="form-group">
                        <label>No. Siri Unit Baharu</label>
                        <input type="text" class="form-control" id="newSerial" placeholder="Cth: NEW-MTR-992" required>
                    </div>
                    <div class="form-group">
                        <label>Spesifikasi Unit Baharu</label>
                        <input type="text" class="form-control" id="newSpecs" placeholder="Cth: 160 kW (Model Moden)" required>
                    </div>
                </div>
                <div style="text-align: right; margin-top: 20px;">
                    <button type="button" class="btn" style="background:#8e8e93;" onclick="closeModal('replaceModal')">Batal</button>
                    <button type="submit" class="btn btn-warning">Sahkan Penukaran</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Pelupusan Aset -->
    <div class="modal" id="disposeModal">
        <div class="modal-content">
            <h3 style="margin-top:0;">Permohonan & Rekod Pelupusan Aset</h3>
            <form onsubmit="saveDisposal(event)">
                <div class="form-group">
                    <label>Pilih Aset Untuk Dilupuskan</label>
                    <select class="form-control" id="disposeAssetSelect" required></select>
                </div>
                <div class="grid-2">
                    <div class="form-group">
                        <label>Kaedah Pelupusan</label>
                        <select class="form-control" id="disposeMethod">
                            <option value="Scrap / Sisa Besi">Scrap / Sisa Besi</option>
                            <option value="Lelong Awam">Lelong Awam</option>
                            <option value="Trade-in Pembekal">Trade-in Pembekal</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>No. Rujukan Kelulusan</label>
                        <input type="text" class="form-control" id="approvalRef" placeholder="Cth: RSAJ/LUPUS/2026/04" required>
                    </div>
                </div>
                <div class="form-group">
                    <label>Justifikasi Pelupusan</label>
                    <textarea class="form-control" id="disposeReason" rows="2" placeholder="Alasan pelupusan peralatan..." required></textarea>
                </div>
                <div style="text-align: right; margin-top: 20px;">
                    <button type="button" class="btn" style="background:#8e8e93;" onclick="closeModal('disposeModal')">Batal</button>
                    <button type="submit" class="btn btn-danger">Sahkan Pelupusan</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Data Aset Permulaan (Contoh LRA & BPH Ranhill SAJ)
        let assets = JSON.parse(localStorage.getItem('rsaj_me_assets')) || [
            { id: 'AST-001', type: 'LRA', loc: 'LRA Semangar', cat: 'Pam Air Utama (Centrifugal Pump)', specs: '200 kW, 600 m³/h', serial: 'SMG-PUMP-01', status: 'Aktif', date: '2022-03-10' },
            { id: 'AST-002', type: 'BPH', loc: 'Booster Pump House Seri Alam', cat: 'Motor Elektrik & VFD', specs: '75 kW VFD Drive', serial: 'SA-MTR-04', status: 'Penyelenggaraan', date: '2023-05-15' },
            { id: 'AST-003', type: 'LRA', loc: 'LRA Sungai Layang', cat: 'Sistem Klorin & Bahan Kimia', specs: '50kg/h Gas Chlorinator', serial: 'SL-CHL-02', status: 'Aktif', date: '2021-11-20' }
        ];

        function saveData() {
            localStorage.setItem('rsaj_me_assets', JSON.stringify(assets));
            renderTable();
            updateStats();
            populateSelects();
        }

        function renderTable() {
            const tbody = document.getElementById('assetTableBody');
            tbody.innerHTML = '';
            
            assets.forEach(a => {
                let badgeClass = 'badge-active';
                if(a.status === 'Penyelenggaraan') badgeClass = 'badge-maint';
                if(a.status === 'Rosak') badgeClass = 'badge-broken';
                if(a.status === 'Ditukar') badgeClass = 'badge-replaced';
                if(a.status === 'Dilupuskan') badgeClass = 'badge-disposed';

                tbody.innerHTML += `
                    <tr>
                        <td><strong>${a.id}</strong></td>
                        <td>[${a.type}] ${a.loc}</td>
                        <td>${a.cat}</td>
                        <td>${a.specs}</td>
                        <td><code>${a.serial}</code></td>
                        <td><span class="badge ${badgeClass}">${a.status}</span></td>
                        <td>
                            <button class="btn" style="padding: 5px 10px; font-size:11px;" onclick="deleteAsset('${a.id}')"><i class="fa fa-trash"></i></button>
                        </td>
                    </tr>
                `;
            });
        }

        function updateStats() {
            document.getElementById('statTotal').innerText = assets.length;
            document.getElementById('statActive').innerText = assets.filter(x => x.status === 'Aktif').valueCount || assets.filter(x => x.status === 'Aktif').length;
            document.getElementById('statReplaced').innerText = assets.filter(x => x.status === 'Ditukar').length;
            document.getElementById('statDisposed').innerText = assets.filter(x => x.status === 'Dilupuskan').length;
        }

        function populateSelects() {
            const oldSel = document.getElementById('oldAssetSelect');
            const dispSel = document.getElementById('disposeAssetSelect');
            oldSel.innerHTML = '';
            dispSel.innerHTML = '';

            assets.filter(x => x.status !== 'Dilupuskan' && x.status !== 'Ditukar').forEach(a => {
                const opt = `<option value="${a.id}">[${a.serial}] ${a.loc} - ${a.cat}</option>`;
                oldSel.innerHTML += opt;
                dispSel.innerHTML += opt;
            });
        }

        function openModal(id) { document.getElementById(id).style.display = 'flex'; populateSelects(); }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        function saveNewAsset(e) {
            e.preventDefault();
            const newAsset = {
                id: 'AST-' + String(Math.floor(100 + Math.random() * 900)),
                type: document.getElementById('locType').value,
                loc: document.getElementById('locName').value,
                cat: document.getElementById('catMek').value,
                specs: document.getElementById('specs').value,
                serial: document.getElementById('serialNo').value,
                status: 'Aktif',
                date: document.getElementById('installDate').value
            };
            assets.unshift(newAsset);
            saveData();
            closeModal('assetModal');
            e.target.reset();
        }

        function saveReplacement(e) {
            e.preventDefault();
            const oldId = document.getElementById('oldAssetSelect').value;
            const asset = assets.find(x => x.id === oldId);
            if(asset) {
                asset.status = 'Ditukar';
            }
            // Tambah unit baru hasil gantian
            const newAsset = {
                id: 'AST-' + String(Math.floor(100 + Math.random() * 900)),
                type: asset ? asset.type : 'LRA',
                loc: asset ? asset.loc : 'Loji Ranhill',
                cat: asset ? asset.cat : 'Peralatan M&E',
                specs: document.getElementById('newSpecs').value,
                serial: document.getElementById('newSerial').value,
                status: 'Aktif',
                date: new Date().toISOString().split('T')[0]
            };
            assets.unshift(newAsset);
            saveData();
            closeModal('replaceModal');
        }

        function saveDisposal(e) {
            e.preventDefault();
            const id = document.getElementById('disposeAssetSelect').value;
            const asset = assets.find(x => x.id === id);
            if(asset) {
                asset.status = 'Dilupuskan';
            }
            saveData();
            closeModal('disposeModal');
        }

        function deleteAsset(id) {
            if(confirm('Adakah anda pasti mahu memadam rekod aset ini?')) {
                assets = assets.filter(x => x.id !== id);
                saveData();
            }
        }

        function filterTable() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const rows = document.querySelectorAll('#assetTableBody tr');
            rows.forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(query) ? '' : 'none';
            });
        }

        // Init pertama
        window.onload = () => {
            renderTable();
            updateStats();
        };
    </script>
</body>
</html>
